{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rfg.dev/schema/status.json",
  "title": "Status",
  "type": "object",
  "required": ["roadmap_id", "steps", "next"],
  "additionalProperties": false,
  "properties": {
    "roadmap_id": { "type": "string" },
    "hypothesis": { "type": "string" },
    "next": { "type": ["string", "null"] },
    "dirty": { "type": "boolean" },
    "worktree": { "type": "string" },
    "last_checkpoint": { "type": ["string", "null"] },
    "goal": { "$ref": "goal.json" },
    "profile": { "type": "string" },
    "oracles": {
      "type": "array",
      "items": { "$ref": "oracle.json" }
    },
    "next_step": { "type": ["object", "null"] },
    "claim_step": { "type": "string" },
    "claim_agent": { "type": "string" },
    "applies_used": { "type": "integer" },
    "budget": { "$ref": "budget.json" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["pending", "ready", "claimed", "in_progress", "blocked", "applied", "implemented", "verified", "failed"]
          },
          "depends_on": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}

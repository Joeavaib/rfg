{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rfg.dev/schema/step.json",
  "title": "Step",
  "type": "object",
  "required": ["id", "title"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "depends_on": {
      "type": "array",
      "items": { "type": "string" }
    },
    "replace": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "paths": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "verify": { "type": "string" },
    "oracle": {
      "type": "string",
      "enum": ["test", "perf", "debug", "security"]
    },
    "goal": {
      "type": "string",
      "description": "Alias of want (legacy)"
    },
    "want": {
      "type": "string",
      "description": "What should be true after this step; does not replace the roadmap goal"
    },
    "paths": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Affected paths (may not exist yet). Prefer this over empty replace."
    },
    "extras": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Allowlisted side artefacts (e.g. rfgfeedback.md) staged without polluting path[]."
    },
    "engine": { "type": "string", "description": "replace | ast-grep | manual | implement | scaffold | run | survey" },
    "diff_budget": { "type": "integer", "minimum": 0 },
    "edge": { "type": "string", "description": "cgo | pyo3 | napi | cxx-ffi" }
  }
}
